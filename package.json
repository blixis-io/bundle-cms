{
  "name": "bundle-cms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:packed": "node tooling/smoke/packed.mjs",
    "ci": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^5.0.2",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rolldown": "^1.2.11",
    "rolldown-plugin-dts": "^0.28.6",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
